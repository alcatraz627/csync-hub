<?xml version="1.0" encoding="utf-8"?>
<!-- More, and its two reading pages. Each page is a column that MainActivity fills with Kit parts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">
    <include android:id="@+id/more_crumb" layout="@layout/kit_page_top"/>
    <ScrollView android:id="@+id/more_overview" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:id="@+id/more_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="@dimen/kit_gutter" android:paddingEnd="@dimen/kit_gutter"
            android:paddingBottom="16dp"/>
    </ScrollView>
    <ScrollView android:id="@+id/more_guide" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:visibility="gone">
        <LinearLayout android:id="@+id/guide_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="@dimen/kit_gutter" android:paddingEnd="@dimen/kit_gutter"
            android:paddingBottom="16dp"/>
    </ScrollView>
    <ScrollView android:id="@+id/more_help" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:visibility="gone">
        <LinearLayout android:id="@+id/help_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="@dimen/kit_gutter" android:paddingEnd="@dimen/kit_gutter"
            android:paddingBottom="16dp"/>
    </ScrollView>
    <ScrollView android:id="@+id/more_reminders" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:visibility="gone">
        <LinearLayout android:id="@+id/reminders_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="@dimen/kit_gutter" android:paddingEnd="@dimen/kit_gutter"
            android:paddingBottom="16dp"/>
    </ScrollView>
    <ScrollView android:id="@+id/more_timers" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:visibility="gone">
        <LinearLayout android:id="@+id/timers_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="@dimen/kit_gutter" android:paddingEnd="@dimen/kit_gutter"
            android:paddingBottom="16dp"/>
    </ScrollView>
    <ScrollView android:id="@+id/more_showcase" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:visibility="gone">
        <LinearLayout android:id="@+id/showcase_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="@dimen/kit_gutter" android:paddingEnd="@dimen/kit_gutter"
            android:paddingBottom="16dp"/>
    </ScrollView>
</LinearLayout>
