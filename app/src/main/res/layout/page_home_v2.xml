<?xml version="1.0" encoding="utf-8"?>
<!-- Home is the map: a hero, what to pick up, then every capability as cards in two tiers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <include android:id="@+id/home_top" layout="@layout/kit_page_top"/>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/home_refresh"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/kit_gutter" android:paddingEnd="@dimen/kit_gutter"
            android:paddingTop="6dp" android:paddingBottom="28dp">

            <!-- The hero: a greeting over the devices turning slowly around the Pi. -->
            <FrameLayout android:id="@+id/home_hero"
                android:layout_width="match_parent" android:layout_height="164dp">
                <com.csync.hub.HeroView android:id="@+id/home_hero_art"
                    android:layout_width="match_parent" android:layout_height="match_parent"/>
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="start|center_vertical" android:orientation="vertical"
                    android:paddingStart="20dp" android:paddingEnd="8dp">
                    <TextView android:id="@+id/home_hero_greeting" style="@style/Kit.Text.RowTitle"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="24sp"/>
                    <TextView android:id="@+id/home_hero_line" style="@style/Kit.Text.Meta"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </FrameLayout>

            <include android:id="@+id/home_pickup_head" layout="@layout/kit_section_head"/>
            <!-- The last conversation, and what was last played when there is one. Rows are added in code. -->
            <LinearLayout android:id="@+id/home_pickup_content"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <!-- The capabilities, large cards then smaller ones, drawn from the catalogue. -->
            <LinearLayout android:id="@+id/home_primary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="-4dp" android:layout_marginEnd="-4dp"
                android:orientation="vertical"/>
            <LinearLayout android:id="@+id/home_secondary"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginStart="-4dp" android:layout_marginEnd="-4dp"
                android:orientation="vertical"/>

            <!-- The app's own line: its version, opening About. -->
            <LinearLayout android:id="@+id/home_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:layout_marginTop="14dp"
                android:paddingStart="4dp" android:paddingEnd="4dp"
                android:gravity="center_vertical" android:orientation="horizontal"
                android:background="?attr/selectableItemBackground">
                <TextView android:id="@+id/home_status_words" style="@style/Kit.Text.RowSub"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"/>
                <TextView android:id="@+id/home_status_version" style="@style/Kit.Text.Meta"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"/>
                <ImageView android:layout_width="16dp" android:layout_height="16dp"
                    android:src="@drawable/csi_forward" app:tint="@color/dim"
                    android:importantForAccessibility="no"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
