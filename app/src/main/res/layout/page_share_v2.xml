<?xml version="1.0" encoding="utf-8"?>
<!-- Share: Compose and Inbox, two modes of one page, built from the shared kit_* pieces. Recipients open in a drawer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">
    <include android:id="@+id/share_top" layout="@layout/kit_page_top"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/kit_gutter" android:paddingEnd="@dimen/kit_gutter"
            android:paddingBottom="24dp">
            <LinearLayout android:id="@+id/share_compose"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Who receives, with whether they are online. Tapping it chooses someone else. -->
                <LinearLayout android:id="@+id/share_recipient" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="8dp"
                    android:orientation="vertical"/>
                <EditText android:id="@+id/share_text"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:minHeight="96dp" android:minLines="3" android:gravity="top|start"
                    android:padding="14dp" android:hint="Write a message"
                    android:inputType="textMultiLine|textCapSentences" android:background="@drawable/card_bg"
                    android:textSize="14.5sp" android:textColor="@color/text"
                    android:textColorHint="@color/dim"/>
                <!-- What else goes with the message: a file, or what is on the clipboard. -->
                <LinearLayout android:id="@+id/share_adds" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"
                    android:orientation="vertical"/>
                <FrameLayout android:id="@+id/share_send_host" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="12dp"/>
                <TextView android:id="@+id/share_status" style="@style/Kit.Text.Meta"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" android:visibility="gone"/>

                <TextView style="@style/Kit.Text.Section"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:layout_marginBottom="8dp"
                    android:text="Sent from this phone"/>
                <LinearLayout android:id="@+id/share_sent" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/share_inbox_section"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <LinearLayout android:id="@+id/share_inbox" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
