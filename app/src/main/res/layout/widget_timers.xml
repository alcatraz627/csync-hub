<?xml version="1.0" encoding="utf-8"?>
<!-- Running timers, each with its buttons, then saved tiles to start one. The heading opens Timers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="8dp" android:paddingTop="10dp"
    android:paddingBottom="10dp" android:background="@drawable/wg_bg">
    <LinearLayout android:id="@+id/wg_open" android:layout_width="match_parent" android:layout_height="32dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/wg_timer"
            android:tint="@color/coral" android:contentDescription="@null"/>
        <TextView android:id="@+id/wg_title" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="Timers"
            android:textSize="14sp" android:textStyle="bold" android:textColor="@color/text" android:maxLines="1"/>
        <TextView android:id="@+id/wg_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginEnd="6dp" android:textSize="12sp" android:textColor="@color/dim" android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/wg_rows" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"/>
    <LinearLayout android:id="@+id/wg_tiles" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="horizontal"/>
</LinearLayout>
