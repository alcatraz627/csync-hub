<?xml version="1.0" encoding="utf-8"?>
<!-- Look T3 (owner pick 2026-10-03): the soonest timer as a big ring with its buttons, the others
     as a short list with Pause, saved tiles below. The heading opens Timers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wg_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="10dp" android:paddingTop="10dp"
    android:paddingBottom="10dp" android:background="@drawable/wg_bg">
    <LinearLayout android:id="@+id/wg_open" android:layout_width="match_parent" android:layout_height="28dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="15dp" android:layout_height="15dp" android:src="@drawable/wg_timer"
            android:tint="@color/coral" android:contentDescription="@null"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="7dp" android:text="Timers" android:textSize="13sp" android:textStyle="bold"
            android:textColor="@color/text" android:maxLines="1"/>
        <TextView android:id="@+id/wg_state" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="@color/dim" android:maxLines="1"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/wg_body" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout android:id="@+id/wt_hero" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal">
            <FrameLayout android:layout_width="78dp" android:layout_height="78dp">
                <ImageView android:id="@+id/wt_ring" android:layout_width="match_parent" android:layout_height="match_parent"
                    android:contentDescription="@null"/>
                <Chronometer android:id="@+id/wt_clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:textSize="15sp" android:textColor="@color/text"
                    android:fontFamily="monospace"/>
                <TextView android:id="@+id/wt_still" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_gravity="center" android:textSize="15sp" android:textColor="@color/dim"
                    android:fontFamily="monospace" android:visibility="gone"/>
            </FrameLayout>
            <TextView android:id="@+id/wt_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:textSize="12sp" android:textColor="@color/dim" android:maxLines="1"/>
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:orientation="horizontal">
                <ImageButton android:id="@+id/wt_toggle" android:layout_width="36dp" android:layout_height="36dp"
                    android:padding="9dp" android:scaleType="fitCenter" android:tint="@color/text"
                    android:src="@drawable/wg_pause" android:background="@drawable/wg_btn" android:contentDescription="Pause"/>
                <ImageButton android:id="@+id/wt_add" android:layout_width="36dp" android:layout_height="36dp"
                    android:layout_marginStart="4dp" android:padding="8dp" android:scaleType="fitCenter" android:tint="@color/text"
                    android:src="@drawable/wg_plus_one" android:background="@drawable/wg_btn" android:contentDescription="Add a minute"/>
                <ImageButton android:id="@+id/wt_stop" android:layout_width="36dp" android:layout_height="36dp"
                    android:layout_marginStart="4dp" android:padding="10dp" android:scaleType="fitCenter" android:tint="@color/danger"
                    android:src="@drawable/wg_stop" android:background="@drawable/wg_btn" android:contentDescription="Stop"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/wg_rows" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical"/>
    </LinearLayout>
    <TextView android:id="@+id/wg_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" android:text="No timer running. Start one:" android:textSize="13sp"
        android:textColor="@color/dim" android:visibility="gone"/>
    <LinearLayout android:id="@+id/wg_tiles" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="horizontal"/>
</LinearLayout>
