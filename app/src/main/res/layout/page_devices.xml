<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/dev_self"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:paddingBottom="10dp"
            android:text="This device"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:paddingTop="6dp"
            android:text="Home peer (this Mac)"/>

        <EditText
            android:id="@+id/dev_ip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="tailnet IP, e.g. 100.65.206.85"
            android:inputType="text"/>

        <EditText
            android:id="@+id/dev_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="mesh token"
            android:inputType="text"/>

        <Button
            android:id="@+id/dev_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:paddingTop="14dp"
            android:text="Send text to home peer"/>

        <EditText
            android:id="@+id/dev_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:hint="type or paste text"
            android:inputType="textMultiLine"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/dev_send_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send text"/>

            <Button
                android:id="@+id/dev_send_clip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send clipboard"/>
        </LinearLayout>

        <Button
            android:id="@+id/dev_scan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Scan peers"/>

        <Button
            android:id="@+id/dev_receiver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start receiving"/>

        <TextView
            android:id="@+id/dev_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text=""/>
    </LinearLayout>
</ScrollView>
