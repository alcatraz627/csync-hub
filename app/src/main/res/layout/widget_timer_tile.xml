<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wq_root" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp"
    android:layout_marginEnd="6dp" android:orientation="horizontal" android:gravity="center"
    android:background="@drawable/wg_tile">
    <ImageView android:id="@+id/wq_dot" android:layout_width="8dp" android:layout_height="8dp"
        android:src="@drawable/wg_dot" android:contentDescription="@null"/>
    <TextView android:id="@+id/wq_words" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginStart="6dp" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text"
        android:maxLines="1"/>
</LinearLayout>
