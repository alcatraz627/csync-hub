<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- app bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="18dp" android:paddingRight="18dp"
        android:paddingTop="16dp" android:paddingBottom="12dp"
        android:background="@color/surface">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Tools" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="the widget and this phone" android:textSize="12sp" android:textColor="@color/dim"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <Button android:id="@+id/tools_media"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Browse and play Pi media"/>

        <Button android:id="@+id/tools_update"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Update csync from Pi"/>
        <TextView android:id="@+id/tools_update_status"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/dim" android:paddingBottom="8dp"
            android:text="Updates use the Pi connection; Android may ask to approve installation."/>

        <!-- xkcd card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="XKCD WIDGET" android:textSize="12sp" android:textStyle="bold"
                android:textColor="@color/dim" android:letterSpacing="0.06" android:layout_marginBottom="8dp"/>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:textColor="@color/text" android:lineSpacingMultiplier="1.2"
                android:text="Long-press the home screen, choose Widgets, and add csync xkcd. It shows a random comic, refreshes hourly, resizes freely, and opens the comic when tapped."/>
        </LinearLayout>

        <!-- system monitor card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="14dp"
            android:layout_marginTop="14dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="SYSTEM MONITOR" android:textSize="12sp" android:textStyle="bold"
                    android:textColor="@color/dim" android:letterSpacing="0.06"/>
                <Button android:id="@+id/sys_refresh"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Refresh"/>
            </LinearLayout>
            <TextView android:id="@+id/sys_status"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingTop="4dp" android:paddingBottom="6dp"
                android:textSize="13sp" android:textColor="@color/dim" android:text="Starting..."/>
            <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:id="@+id/sys_output"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:fontFamily="monospace" android:textSize="11sp"
                        android:textColor="@color/text" android:text=""/>
                </HorizontalScrollView>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
