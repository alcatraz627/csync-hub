<?xml version="1.0" encoding="utf-8"?>
<!-- Settings is one page: Connection opens its own page, and Playback, Assistant and Appearance fold in place. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <include android:id="@+id/settings_back" layout="@layout/kit_page_top"/>

    <ScrollView android:id="@+id/settings_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/kit_gutter" android:paddingEnd="@dimen/kit_gutter"
            android:paddingTop="6dp" android:paddingBottom="24dp">

            <LinearLayout android:id="@+id/settings_overview"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout android:id="@+id/set_connection_group"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" android:orientation="vertical"/>

                <include android:id="@+id/set_sec_playback" layout="@layout/kit_section_head"/>
                <LinearLayout android:id="@+id/set_playback_body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <include android:id="@+id/set_sec_assistant" layout="@layout/kit_section_head"/>
                <LinearLayout android:id="@+id/set_assistant_body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <include android:id="@+id/set_sec_appearance" layout="@layout/kit_section_head"/>
                <LinearLayout android:id="@+id/set_appearance_body"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView style="@style/CsyncAppearanceHeading" android:text="Theme"/>
                    <LinearLayout android:id="@+id/set_theme_group" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:orientation="horizontal"/>
                    <TextView style="@style/CsyncAppearanceHeading" android:layout_marginTop="20dp"
                        android:text="Text size"/>
                    <LinearLayout android:id="@+id/set_text_size_group" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp"
                        android:orientation="horizontal"/>
                    <TextView style="@style/CsyncAppearanceHeading" android:layout_marginTop="20dp"
                        android:text="Primary colour"/>
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:scrollbars="none">
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <View android:id="@+id/set_accent_coral" style="@style/CsyncAccentSwatch" android:contentDescription="Coral"/>
                            <View android:id="@+id/set_accent_teal" style="@style/CsyncAccentSwatch" android:contentDescription="Teal"/>
                            <View android:id="@+id/set_accent_violet" style="@style/CsyncAccentSwatch" android:contentDescription="Violet"/>
                            <View android:id="@+id/set_accent_rust" style="@style/CsyncAccentSwatch" android:contentDescription="Rust"/>
                            <View android:id="@+id/set_accent_blue" style="@style/CsyncAccentSwatch" android:contentDescription="Blue"/>
                            <View android:id="@+id/set_accent_leaf" style="@style/CsyncAccentSwatch" android:contentDescription="Leaf"/>
                            <View android:id="@+id/set_accent_rose" style="@style/CsyncAccentSwatch" android:contentDescription="Rose"/>
                            <ImageView android:id="@+id/set_accent_custom" style="@style/CsyncAccentSwatch"
                                android:src="@drawable/csi_palette" android:padding="11dp"
                                android:contentDescription="Your own colour"/>
                        </LinearLayout>
                    </HorizontalScrollView>
                    <TextView style="@style/CsyncAppearanceHeading" android:layout_marginTop="20dp"
                        android:text="App icon"/>
                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="8dp" android:scrollbars="none">
                        <LinearLayout android:id="@+id/set_icon_row" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:orientation="horizontal"/>
                    </HorizontalScrollView>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="10dp" android:textSize="12sp" android:textColor="@color/dim"
                        android:text="Theme, size and colour apply to every screen and the system bars. The home screen redraws when the icon changes."/>
                    <TextView style="@style/CsyncAppearanceHeading" android:layout_marginTop="20dp"
                        android:text="Quick rail"/>
                    <!-- The two floating buttons at the top corners: what bar 1 holds, and the one action on the right. -->
                    <LinearLayout android:id="@+id/set_rail_body" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical"/>
                </LinearLayout>
            </LinearLayout>

            <!-- The Connection page: the one long form, with Save. -->
            <LinearLayout
                android:id="@+id/settings_connection_detail" android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <TextView android:id="@+id/set_conn_status"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="17sp" android:textStyle="bold" android:textColor="@color/text"/>

                <TextView style="@style/CsyncAppearanceHeading" android:layout_marginTop="20dp"
                    android:text="Raspberry Pi address"/>
                <EditText android:id="@+id/set_assist"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:hint="raspberrypi" android:inputType="textNoSuggestions"
                    android:textColor="@color/text" android:textColorHint="@color/dim"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/dim"
                    android:text="Where Media, Chat, the camera and Notes live."/>

                <TextView style="@style/CsyncAppearanceHeading" android:layout_marginTop="18dp"
                    android:text="Second address (optional)"/>
                <EditText android:id="@+id/set_home"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:hint="studio-mac" android:inputType="textNoSuggestions"
                    android:textColor="@color/text" android:textColorHint="@color/dim"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/dim"
                    android:text="A device that is usually on. It finds your devices when the Pi is off."/>

                <TextView style="@style/CsyncAppearanceHeading" android:layout_marginTop="18dp"
                    android:text="Access token"/>
                <EditText android:id="@+id/set_token"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:hint="Token" android:inputType="textPassword"
                    android:textColor="@color/text" android:textColorHint="@color/dim"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:textSize="12sp" android:textColor="@color/dim"
                    android:text="The same token on every device you own."/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/set_save"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:minHeight="48dp" android:layout_marginTop="14dp" android:text="Save"
                    app:icon="@drawable/csi_check"/>

                <LinearLayout android:id="@+id/set_receive_group"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" android:orientation="vertical"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
