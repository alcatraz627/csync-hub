<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="48dp"
    android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:id="@+id/wr_open" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/wr_dot" android:layout_width="10dp" android:layout_height="10dp"
            android:src="@drawable/wg_dot" android:contentDescription="@null"/>
        <TextView android:id="@+id/wr_name" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="14sp"
            android:textColor="@color/text" android:maxLines="1" android:ellipsize="none"/>
        <Chronometer android:id="@+id/wr_clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="@color/text" android:fontFamily="monospace"/>
        <TextView android:id="@+id/wr_still" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="15sp" android:textColor="@color/dim" android:fontFamily="monospace" android:visibility="gone"/>
    </LinearLayout>
    <ImageButton android:id="@+id/wr_toggle" android:layout_width="40dp" android:layout_height="40dp"
        android:layout_marginStart="6dp" android:padding="10dp" android:scaleType="fitCenter" android:tint="@color/text"
        android:src="@drawable/wg_pause" android:background="@drawable/wg_btn" android:contentDescription="Pause"/>
    <ImageButton android:id="@+id/wr_add" android:layout_width="40dp" android:layout_height="40dp"
        android:layout_marginStart="4dp" android:padding="9dp" android:scaleType="fitCenter" android:tint="@color/text"
        android:src="@drawable/wg_plus_one" android:background="@drawable/wg_btn" android:contentDescription="Add a minute"/>
    <ImageButton android:id="@+id/wr_stop" android:layout_width="40dp" android:layout_height="40dp"
        android:layout_marginStart="4dp" android:padding="11dp" android:scaleType="fitCenter" android:tint="@color/danger"
        android:src="@drawable/wg_stop" android:background="@drawable/wg_btn" android:contentDescription="Stop"/>
</LinearLayout>
