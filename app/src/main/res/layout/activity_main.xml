<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- The floater dock: what keeps going (media, timers), one card at a time, swiped sideways. -->
    <FrameLayout android:id="@+id/floater_dock" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@color/bg"/>

    <com.csync.hub.SixTabNavigationView
        android:id="@+id/nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="64dp"
        android:background="@color/surface"
        app:labelVisibilityMode="unlabeled"
        app:itemIconSize="24dp"
        app:itemIconTint="@color/nav_icon_tint"
        app:itemActiveIndicatorStyle="@style/Csync.NavIndicator"
        app:menu="@menu/nav_menu"/>
</LinearLayout>
