<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- app bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="10dp" android:paddingRight="12dp"
        android:paddingTop="16dp" android:paddingBottom="12dp"
        android:background="@color/surface">
        <TextView android:id="@+id/chat_back"
            android:layout_width="36dp" android:layout_height="wrap_content"
            android:gravity="center" android:text="‹" android:textSize="24sp"
            android:textColor="@color/text" android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingLeft="8dp">
            <TextView android:id="@+id/chat_title"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Chats" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text"/>
            <TextView android:id="@+id/chat_subtitle"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="assistant" android:textSize="12sp" android:textColor="@color/dim"/>
        </LinearLayout>
        <Button android:id="@+id/chat_new" style="?android:attr/buttonStyleSmall"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New"/>
    </LinearLayout>

    <!-- filter bar (list mode) -->
    <LinearLayout
        android:id="@+id/chat_filterbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="12dp" android:paddingRight="12dp"
        android:paddingTop="6dp" android:paddingBottom="6dp">
        <EditText
            android:id="@+id/chat_search"
            android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:hint="search chats" android:textSize="14sp" android:maxLines="1"
            android:inputType="text" android:textColor="@color/text" android:textColorHint="@color/dim"/>
        <TextView android:id="@+id/chat_toggle_fav"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="★" android:textSize="16sp" android:textColor="@color/dim"
            android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="6dp" android:paddingBottom="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>
        <TextView android:id="@+id/chat_toggle_archived"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Archived" android:textSize="12sp" android:textColor="@color/dim"
            android:paddingLeft="10dp" android:paddingRight="6dp" android:paddingTop="6dp" android:paddingBottom="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>

    <!-- history list -->
    <ScrollView
        android:id="@+id/chat_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="10dp">
        <LinearLayout
            android:id="@+id/chat_history_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <!-- conversation -->
    <LinearLayout
        android:id="@+id/chat_convo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/chat_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="14dp">
            <LinearLayout
                android:id="@+id/chat_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="8dp"/>
        </ScrollView>

        <!-- composer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:padding="10dp"
            android:background="@color/surface">
            <TextView
                android:id="@+id/chat_expand"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:paddingTop="8dp" android:paddingBottom="8dp"
                android:text="⌄"
                android:textSize="18sp"
                android:textColor="@color/dim"
                android:background="?attr/selectableItemBackgroundBorderless"/>
            <EditText
                android:id="@+id/chat_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="message"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="2"
                android:maxLines="2"
                android:scrollbars="vertical"
                android:textColor="@color/text"
                android:textColorHint="@color/dim"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/chat_send"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="2dp"
                android:text="Send"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
