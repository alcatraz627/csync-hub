<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <include android:id="@+id/chat_top" layout="@layout/kit_page_top"/>

    <!-- conversation heading -->
    <LinearLayout
        android:id="@+id/chat_heading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/kit_gutter" android:paddingEnd="12dp"
        android:paddingTop="6dp" android:paddingBottom="4dp">
        <TextView android:id="@+id/chat_back"
            android:layout_width="48dp" android:layout_height="48dp"
            android:gravity="center" android:text=""
            android:drawableStart="@drawable/csi_back" android:drawableTint="@color/text"
            android:contentDescription="Back to conversations"
            android:textColor="@color/text" android:visibility="gone"
            android:background="?attr/selectableItemBackgroundBorderless"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <TextView android:id="@+id/chat_title"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    style="@style/Kit.Text.PageTitle" android:text="Chats"/>
                <EditText android:id="@+id/chat_title_edit"
                    android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:singleLine="true" android:imeOptions="actionDone" android:visibility="gone"
                    android:textSize="22sp" android:textStyle="bold" android:textColor="@color/text"/>
                <ImageView android:id="@+id/chat_edit"
                    android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp"
                    android:src="@drawable/csi_edit" app:tint="@color/dim"
                    android:contentDescription="Edit conversation title" android:visibility="gone"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
                <ImageView android:id="@+id/chat_favorite"
                    android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp"
                    android:src="@drawable/csi_favorite" app:tint="@color/dim"
                    android:contentDescription="Favorite conversation" android:visibility="gone"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
                <ImageView android:id="@+id/chat_archive"
                    android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp"
                    android:src="@drawable/csi_archive" app:tint="@color/dim"
                    android:contentDescription="Archive conversation" android:visibility="gone"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:gravity="center_vertical">
                <View android:id="@+id/chat_presence_dot" android:layout_width="8dp"
                    android:layout_height="8dp" android:layout_marginEnd="5dp"
                    android:background="@drawable/dot_circle"/>
                <TextView android:id="@+id/chat_subtitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    style="@style/Kit.Text.PageSub" android:text="Checking Pi"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- one filter row and one search field (list mode) -->
    <LinearLayout
        android:id="@+id/chat_filterbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/kit_gutter" android:paddingEnd="@dimen/kit_gutter"
        android:paddingTop="8dp" android:paddingBottom="0dp">
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center">
            <TextView android:id="@+id/chat_filter_all" style="@style/CsyncChatTab"
                android:drawableStart="@drawable/csi_menu" android:drawablePadding="4dp"
                android:text="All"/>
            <TextView android:id="@+id/chat_toggle_fav" style="@style/CsyncChatTab"
                android:drawableStart="@drawable/csi_favorite" android:drawablePadding="4dp"
                android:text="Favorites"/>
            <TextView android:id="@+id/chat_toggle_archived" style="@style/CsyncChatTab"
                android:drawableStart="@drawable/csi_archive" android:drawablePadding="4dp"
                android:text="Archived"/>
            <TextView android:id="@+id/chat_filter_tools" style="@style/CsyncChatTab"
                android:drawableStart="@drawable/csi_tools" android:drawablePadding="4dp"
                android:text="Tools"/>
        </LinearLayout>
        </HorizontalScrollView>
        <LinearLayout android:id="@+id/chat_search_wrap"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="8dp" android:gravity="center_vertical"
            android:paddingStart="12dp" android:paddingEnd="10dp"
            android:background="@drawable/card_bg">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/csi_search" app:tint="@color/dim"
                android:importantForAccessibility="no"/>
            <EditText android:id="@+id/chat_search"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:layout_marginStart="9dp" android:background="@android:color/transparent"
                android:hint="Search conversations" android:textSize="14sp" android:maxLines="1"
                android:inputType="text" android:textColor="@color/text" android:textColorHint="@color/dim"/>
        </LinearLayout>
    </LinearLayout>

    <!-- history list -->
    <ScrollView
        android:id="@+id/chat_history"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/kit_gutter" android:paddingEnd="@dimen/kit_gutter">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
        <TextView android:id="@+id/chat_recent_heading" style="@style/Kit.Text.Section"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:layout_marginBottom="8dp"
            android:text="Recent conversations"/>
        <LinearLayout
            android:id="@+id/chat_history_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
        <LinearLayout android:id="@+id/chat_tools_list"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>

    <!-- conversation -->
    <LinearLayout
        android:id="@+id/chat_convo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Find in this conversation: opened from the top bar, closed from it or with Back. -->
        <LinearLayout
            android:id="@+id/chat_find"
            android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical" android:paddingStart="12dp"
            android:background="@drawable/card_bg" android:visibility="gone">
            <ImageView android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/csi_search" app:tint="@color/dim"
                android:importantForAccessibility="no"/>
            <EditText android:id="@+id/chat_find_input"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
                android:layout_marginStart="9dp" android:background="@android:color/transparent"
                android:hint="Find in this conversation" android:textSize="14sp" android:maxLines="1"
                android:inputType="text" android:imeOptions="actionSearch"
                android:textColor="@color/text" android:textColorHint="@color/dim"/>
            <TextView android:id="@+id/chat_find_count"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingStart="6dp" android:paddingEnd="2dp"
                android:textSize="12sp" android:textColor="@color/dim" android:maxLines="1"/>
            <ImageView android:id="@+id/chat_find_prev"
                android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp"
                android:rotation="180"
                android:src="@drawable/ic_chevron_down" app:tint="@color/text"
                android:contentDescription="Earlier match"
                android:background="?attr/selectableItemBackgroundBorderless"/>
            <ImageView android:id="@+id/chat_find_next"
                android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp"
                android:src="@drawable/ic_chevron_down" app:tint="@color/text"
                android:contentDescription="Later match"
                android:background="?attr/selectableItemBackgroundBorderless"/>
            <ImageView android:id="@+id/chat_find_close"
                android:layout_width="48dp" android:layout_height="48dp" android:padding="14dp"
                android:src="@drawable/csi_close" app:tint="@color/dim"
                android:contentDescription="Stop finding"
                android:background="?attr/selectableItemBackgroundBorderless"/>
        </LinearLayout>

        <ScrollView
            android:id="@+id/chat_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:paddingTop="4dp" android:paddingBottom="6dp">
            <LinearLayout
                android:id="@+id/chat_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="0dp"
                android:paddingBottom="8dp"/>
        </ScrollView>

        <!-- Choices offered while typing "/" or "@", directly above the message box. -->
        <ScrollView
            android:id="@+id/chat_suggest"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
            android:visibility="gone">
            <LinearLayout android:id="@+id/chat_suggest_rows"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </ScrollView>

        <!-- The message box: one outlined card holding what is attached, the text, and a row with Add, the model and Send. -->
        <LinearLayout
            android:id="@+id/chat_composer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:layout_marginEnd="10dp"
            android:layout_marginTop="4dp" android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:background="@drawable/card_bg">
            <FrameLayout
                android:id="@+id/chat_expand"
                android:layout_width="match_parent"
                android:layout_height="18dp"
                android:visibility="gone">
                <View android:layout_width="36dp" android:layout_height="4dp"
                    android:layout_gravity="center" android:background="@drawable/kit_handle"/>
            </FrameLayout>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:scrollbars="none" android:paddingStart="10dp" android:paddingEnd="10dp">
                <com.google.android.material.chip.ChipGroup android:id="@+id/chat_attachments"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    app:singleLine="true" android:visibility="gone"/>
            </HorizontalScrollView>
            <EditText
                android:id="@+id/chat_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp"
                android:hint="Message the Pi" android:paddingStart="16dp" android:paddingEnd="16dp"
                android:paddingTop="12dp" android:paddingBottom="4dp"
                android:background="@null"
                android:gravity="top|start"
                android:inputType="textMultiLine|textCapSentences"
                android:minLines="1"
                android:maxLines="6"
                android:scrollbars="vertical"
                android:textSize="15sp"
                android:textColor="@color/text"
                android:textColorHint="@color/dim"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp" android:paddingEnd="6dp" android:paddingBottom="4dp">
                <ImageView
                    android:id="@+id/chat_attach"
                    android:layout_width="48dp" android:layout_height="48dp"
                    android:padding="13dp"
                    android:src="@drawable/csi_plus" app:tint="@color/dim"
                    android:contentDescription="Add to this message"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
                <TextView
                    android:id="@+id/chat_model_pill"
                    android:layout_width="wrap_content" android:layout_height="36dp"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp" android:paddingEnd="14dp"
                    android:drawablePadding="6dp"
                    android:textSize="12sp" android:textColor="@color/dim"
                    android:maxLines="1"
                    android:background="@drawable/pill_off"
                    app:drawableStartCompat="@drawable/csi_speed" app:drawableTint="@color/dim"/>
                <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
                <ImageView
                    android:id="@+id/chat_send"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:padding="12dp"
                    android:src="@drawable/csi_send" app:tint="@color/onAccent"
                    android:contentDescription="Send"
                    android:background="@drawable/chat_send_bg"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
