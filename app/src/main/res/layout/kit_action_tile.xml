<?xml version="1.0" encoding="utf-8"?>
<!-- One large action: an icon over a single word. Bind with Kit.bindAction. Several sit side by side and share the width. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
    android:layout_margin="4dp" android:minHeight="84dp"
    android:paddingTop="14dp" android:paddingBottom="12dp"
    android:orientation="vertical" android:gravity="center"
    android:background="@drawable/kit_area_bg">
    <ImageView android:id="@+id/kit_icon"
        android:layout_width="26dp" android:layout_height="26dp"
        app:tint="?attr/colorPrimary" android:importantForAccessibility="no"/>
    <TextView android:id="@+id/kit_title" style="@style/Kit.Text.RowTitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:maxLines="1" android:textSize="13sp"/>
</LinearLayout>
