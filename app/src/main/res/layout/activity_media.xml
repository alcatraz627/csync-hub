<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">
    <include android:id="@+id/media_top" layout="@layout/kit_page_top"/>
    <ScrollView android:id="@+id/media_list" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">
        <TextView android:id="@+id/media_heading" style="@style/Kit.Text.PageTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:text="Files"/>
        <TextView android:id="@+id/media_subtitle" style="@style/Kit.Text.PageSub"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:paddingStart="20dp" android:paddingEnd="20dp"
            android:text="Connected storage on the Pi"/>
        <LinearLayout android:id="@+id/media_search_line" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginStart="20dp" android:layout_marginEnd="20dp" android:layout_marginTop="12dp"
            android:background="@drawable/card_bg" android:paddingStart="12dp">
            <EditText android:id="@+id/media_search" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="44dp" android:singleLine="true" android:hint="Search connected media"
                android:inputType="text" android:textSize="14sp" android:background="@android:color/transparent"/>
            <ImageView android:id="@+id/media_find" android:layout_width="48dp" android:layout_height="48dp"
                android:padding="14dp" android:src="@drawable/csi_search" app:tint="@color/dim"
                android:contentDescription="Search media"
                android:background="?attr/selectableItemBackground"/>
        </LinearLayout>
        <HorizontalScrollView android:id="@+id/media_sections" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp" android:fillViewport="true" android:scrollbars="none">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:paddingStart="3dp" android:paddingEnd="3dp">
                <TextView android:id="@+id/media_files" style="@style/CsyncMediaTab"
                    android:drawableStart="@drawable/csi_files" android:drawablePadding="5dp" android:text="Files"/>
                <TextView android:id="@+id/media_videos" style="@style/CsyncMediaTab"
                    android:drawableStart="@drawable/csi_video" android:drawablePadding="5dp" android:text="Videos"/>
                <TextView android:id="@+id/media_history" style="@style/CsyncMediaTab"
                    android:drawableStart="@drawable/csi_history" android:drawablePadding="5dp" android:text="History"/>
                <TextView android:id="@+id/media_connections" style="@style/CsyncMediaTab"
                    android:drawableStart="@drawable/csi_access" android:drawablePadding="5dp" android:text="Access"/>
            </LinearLayout>
        </HorizontalScrollView>
        <TextView android:id="@+id/media_status" style="@style/Kit.Text.Section"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="16dp" android:paddingBottom="8dp"
            android:text="Checking drives"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout android:id="@+id/media_rows" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingBottom="16dp"/>
            <LinearLayout android:id="@+id/media_actions_toggle" android:layout_width="match_parent"
                android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
                android:layout_marginTop="12dp" android:layout_marginBottom="8dp"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:contentDescription="From phone or YouTube, collapsed"
                android:background="@drawable/card_bg"
                android:foreground="?attr/selectableItemBackground">
                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:src="@drawable/csi_files" app:tint="?attr/colorPrimary"
                    android:importantForAccessibility="no"/>
                <TextView android:layout_width="0dp" android:layout_weight="1"
                    android:layout_height="wrap_content" android:layout_marginStart="10dp"
                    android:text="From phone or YouTube" android:textSize="13sp"
                    android:textStyle="bold" android:textColor="?attr/colorPrimary"
                    android:importantForAccessibility="no"/>
                <ImageView android:id="@+id/media_actions_chevron" android:layout_width="18dp"
                    android:layout_height="18dp" android:src="@drawable/csi_chevron"
                    app:tint="?attr/colorPrimary" android:importantForAccessibility="no"/>
            </LinearLayout>
            <LinearLayout android:id="@+id/media_actions" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"
                android:layout_marginStart="20dp" android:layout_marginEnd="20dp"
                android:layout_marginBottom="16dp" android:background="@drawable/card_bg">
                <TextView android:id="@+id/media_cast_file" style="@style/CsyncMediaAction"
                    android:drawableStart="@drawable/csi_files" android:drawableTint="@color/dim"
                    android:drawablePadding="10dp" android:text="Send a phone file to Pi screen"/>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border"/>
                <TextView android:id="@+id/media_cast_youtube" style="@style/CsyncMediaAction"
                    android:drawableStart="@drawable/csi_video" android:drawableTint="@color/dim"
                    android:drawablePadding="10dp" android:text="Play a YouTube link on Pi"/>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border"/>
                <TextView android:id="@+id/media_wallpaper" style="@style/CsyncMediaAction"
                    android:drawableStart="@drawable/csi_photo" android:drawableTint="@color/dim"
                    android:drawablePadding="10dp" android:text="Choose Pi screen image"/>
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <ScrollView android:id="@+id/media_full_player" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:visibility="gone"
        android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="12dp" android:paddingBottom="12dp">
            <TextView android:id="@+id/player_target_state" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="Pi screen · idle"
                android:textSize="12sp" android:textColor="@color/dim"/>
            <TextView android:id="@+id/player_title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="3dp"
                android:text="No media selected" android:textSize="18sp" android:textStyle="bold"
                android:textColor="@color/text"/>
            <TextView android:id="@+id/player_art" android:layout_width="match_parent" android:layout_height="150dp"
                android:layout_marginTop="10dp" android:gravity="bottom|start" android:padding="12dp"
                android:text="Display idle" android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/text" android:background="@drawable/player_poster_bg"/>
            <TextView android:id="@+id/player_feedback" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="5dp"
                android:textSize="12sp" android:textColor="@color/dim"/>
            <SeekBar android:id="@+id/player_seek" android:layout_width="match_parent"
                android:layout_height="36dp" android:layout_marginTop="3dp"
                android:progressTint="?attr/colorPrimary" android:thumbTint="?attr/colorPrimary"
                android:progressBackgroundTint="@color/border"
                android:contentDescription="Playback position"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/player_position" android:layout_width="0dp"
                    android:layout_weight="1" android:layout_height="wrap_content"
                    android:text="0:00" android:textSize="12sp" android:textColor="@color/dim"/>
                <TextView android:id="@+id/player_duration" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="--:--"
                    android:textSize="12sp" android:textColor="@color/dim"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:gravity="center" android:orientation="horizontal">
                <ImageView android:id="@+id/player_favorite" style="@style/CsyncPlayerIcon"
                    android:src="@drawable/csi_favorite" android:contentDescription="Favorite"/>
                <ImageView android:id="@+id/player_back10" style="@style/CsyncPlayerIcon"
                    android:src="@drawable/csi_rewind" android:contentDescription="Rewind"/>
                <ImageView android:id="@+id/player_pause" style="@style/CsyncPlayerIcon"
                    android:src="@drawable/csi_pause" android:background="@drawable/player_primary_bg"
                    android:contentDescription="Pause"/>
                <ImageView android:id="@+id/player_forward10" style="@style/CsyncPlayerIcon"
                    android:src="@drawable/csi_fastforward" android:contentDescription="Forward"/>
                <ImageView android:id="@+id/player_skip_choice" style="@style/CsyncPlayerIcon"
                    android:src="@drawable/csi_sliders" android:contentDescription="Skip length"/>
                <ImageView android:id="@+id/player_stop" style="@style/CsyncPlayerIcon"
                    android:src="@drawable/csi_stop" android:contentDescription="Stop"/>
            </LinearLayout>
            <TextView style="@style/Kit.Text.Section" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:layout_marginBottom="8dp" android:text="Playback"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView android:id="@+id/player_volume" style="@style/CsyncPlayerTile"
                    android:drawableStart="@drawable/csi_volume" android:text="Volume · 0%"/>
                <TextView android:id="@+id/player_speed" style="@style/CsyncPlayerTile"
                    android:drawableStart="@drawable/csi_speed" android:text="Speed · 1×"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="6dp">
                <TextView android:id="@+id/player_rotate" style="@style/CsyncPlayerTile"
                    android:drawableStart="@drawable/csi_rotate" android:text="Rotate · unavailable" android:enabled="false"/>
                <TextView android:id="@+id/player_loop" style="@style/CsyncPlayerTile"
                    android:drawableStart="@drawable/csi_loop" android:text="Loop · unavailable" android:enabled="false"/>
            </LinearLayout>
            <TextView android:id="@+id/player_skip" android:layout_width="match_parent"
                android:layout_height="48dp" android:gravity="center_vertical" android:visibility="gone"
                android:text="Skip · 10 seconds" android:textSize="13sp"
                android:textColor="@color/dim" android:background="?attr/selectableItemBackground"/>
        </LinearLayout>
    </ScrollView>
    <SurfaceView android:id="@+id/media_video" android:layout_width="match_parent"
        android:layout_height="180dp" android:visibility="gone"/>
    <LinearLayout android:id="@+id/media_player_controls" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone"
        android:background="@color/surface" android:paddingStart="8dp" android:paddingEnd="8dp"
        android:paddingTop="3dp" android:paddingBottom="3dp">
        <SeekBar android:id="@+id/media_seek" android:layout_width="match_parent"
            android:layout_height="1dp" android:visibility="gone"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="52dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageView android:layout_width="24dp" android:layout_height="24dp"
                android:src="@drawable/csi_media" app:tint="?attr/colorPrimary"
                android:importantForAccessibility="no"/>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="wrap_content" android:orientation="vertical"
                android:layout_marginStart="8dp">
                <TextView android:id="@+id/media_output" android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="10sp" android:textColor="@color/dim"/>
                <TextView android:id="@+id/media_now" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="Nothing playing"
                    android:maxLines="2"
                    android:textSize="13sp" android:textStyle="bold" android:textColor="@color/text"/>
            </LinearLayout>
            <ImageView android:id="@+id/media_pause" style="@style/CsyncMiniIcon"
                android:src="@drawable/csi_pause" android:contentDescription="Pause"/>
            <ImageView android:id="@+id/media_resume" style="@style/CsyncMiniIcon"
                android:src="@drawable/csi_play" android:contentDescription="Resume" android:visibility="gone"/>
            <ImageView android:id="@+id/media_stop" style="@style/CsyncMiniIcon"
                android:src="@drawable/csi_stop" android:contentDescription="Stop"/>
            <ImageView android:id="@+id/media_mute" style="@style/CsyncMiniIcon"
                android:src="@drawable/csi_volume" android:contentDescription="Mute"/>
            <ImageView android:id="@+id/media_volume" style="@style/CsyncMiniIcon"
                android:src="@drawable/csi_volume" android:contentDescription="Volume" android:visibility="gone"/>
            <ImageView android:id="@+id/media_settings" style="@style/CsyncMiniIcon"
                android:src="@drawable/csi_speed" android:contentDescription="Playback settings"/>
        </LinearLayout>
    </LinearLayout>
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/media_bottom_nav" android:layout_width="match_parent"
        android:layout_height="64dp" android:background="@color/surface"
        app:labelVisibilityMode="unlabeled" app:itemIconSize="24dp"
        app:itemIconTint="@color/nav_icon_tint"
        app:itemActiveIndicatorStyle="@style/Csync.NavIndicator" app:menu="@menu/nav_menu"/>
</LinearLayout>
