<?xml version="1.0" encoding="utf-8"?>
<!-- The row above the bottom nav while something plays. Tap it for the half-height panel; the icons act directly. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@color/surface"
    android:paddingStart="12dp" android:paddingEnd="6dp" android:paddingTop="6dp"
    android:paddingBottom="4dp" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginEnd="8dp"
            android:src="@drawable/csi_media" app:tint="?attr/colorPrimary" android:importantForAccessibility="no"/>
        <LinearLayout android:id="@+id/mini_open" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="48dp" android:orientation="vertical"
            android:gravity="center_vertical" android:background="?attr/selectableItemBackground">
            <TextView android:id="@+id/mini_target" style="@style/Kit.Text.Meta"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="PI SCREEN · PLAYING" android:textSize="10sp" android:singleLine="true"/>
            <TextView android:id="@+id/mini_title" style="@style/Kit.Text.RowTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="2dp" android:singleLine="true" android:ellipsize="none"
                android:textSize="13sp" android:text="Media"/>
        </LinearLayout>
        <ImageView android:id="@+id/mini_pause" android:layout_width="40dp" android:layout_height="40dp"
            android:padding="10dp" android:src="@drawable/csi_pause" app:tint="@color/text"
            android:contentDescription="Pause" android:background="?attr/selectableItemBackgroundBorderless"/>
        <ImageView android:id="@+id/mini_stop" android:layout_width="40dp" android:layout_height="40dp"
            android:padding="10dp" android:src="@drawable/csi_stop" app:tint="@color/text"
            android:contentDescription="Stop" android:background="?attr/selectableItemBackgroundBorderless"/>
        <ImageView android:id="@+id/mini_volume" android:layout_width="40dp" android:layout_height="40dp"
            android:padding="10dp" android:src="@drawable/csi_volume" app:tint="@color/text"
            android:contentDescription="Volume" android:background="?attr/selectableItemBackgroundBorderless"/>
        <ImageView android:id="@+id/mini_speed" android:layout_width="40dp" android:layout_height="40dp"
            android:padding="10dp" android:src="@drawable/csi_speed" app:tint="@color/text"
            android:contentDescription="Speed" android:background="?attr/selectableItemBackgroundBorderless"/>
    </LinearLayout>
    <ProgressBar android:id="@+id/mini_progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="4dp"
        android:max="1000" android:progress="0" android:progressTint="?attr/colorPrimary"
        android:progressBackgroundTint="@color/border"/>
</LinearLayout>
