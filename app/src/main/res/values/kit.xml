<?xml version="1.0" encoding="utf-8"?>
<!--
  The shared look of every screen: one type scale, one set of spacing values, and
  one style per building block. The values are the design system's
  (csync docs/android-ui-system.md, Type and Space and shape). Screens use these
  instead of setting sizes and colors themselves, so a fix here reaches every page.
-->
<resources>
    <color name="warn">#8A5D00</color>

    <dimen name="kit_gutter">16dp</dimen>
    <dimen name="kit_top_height">52dp</dimen>
    <dimen name="kit_row_min">60dp</dimen>
    <dimen name="kit_row_pad_v">10dp</dimen>
    <dimen name="kit_row_pad_h">12dp</dimen>
    <dimen name="kit_row_gap">12dp</dimen>
    <dimen name="kit_tile">38dp</dimen>
    <dimen name="kit_tile_icon">18dp</dimen>
    <dimen name="kit_card_radius">16dp</dimen>
    <dimen name="kit_area_radius">14dp</dimen>
    <dimen name="kit_area_min">68dp</dimen>
    <dimen name="kit_section_gap">18dp</dimen>
    <dimen name="kit_dot">8dp</dimen>

    <!-- Type scale. Sizes are in sp so the app's text-size setting scales all of them together. -->
    <style name="Kit.Text" parent="">
        <item name="android:textColor">@color/text</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <!--
      The top bar names the page, so a second title and tagline under it are hidden
      everywhere. A page about one named thing (a conversation, a recipient) shows
      its heading from code.
    -->
    <style name="Kit.Text.PageTitle">
        <item name="android:visibility">gone</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>
    <style name="Kit.Text.PageSub">
        <item name="android:visibility">gone</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
    <style name="Kit.Text.Section">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Kit.Text.RowTitle">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Kit.Text.RowSub">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>
    <style name="Kit.Text.Meta">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/dim</item>
    </style>
    <style name="Kit.Pill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">11dp</item>
        <item name="android:paddingEnd">11dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:background">@drawable/pill_off</item>
        <item name="android:textColor">@color/dim</item>
        <item name="android:textSize">12.5sp</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="Kit.Text.Crumb">
        <item name="android:textSize">13.5sp</item>
        <item name="android:textColor">@color/dim</item>
    </style>
    <style name="Kit.Text.CrumbCurrent">
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
