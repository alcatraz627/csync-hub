<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Csync" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/coral</item>
        <item name="colorOnPrimary">@color/onAccent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorOnBackground">@color/text</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Theme.Csync.Coral" parent="Theme.Csync"/>
    <style name="Theme.Csync.Teal" parent="Theme.Csync">
        <item name="colorPrimary">@color/teal</item>
    </style>
    <style name="Theme.Csync.Violet" parent="Theme.Csync">
        <item name="colorPrimary">@color/violet</item>
    </style>
    <style name="Theme.Csync.Rust" parent="Theme.Csync">
        <item name="colorPrimary">@color/rust</item>
    </style>

    <style name="Theme.Csync.Dialog" parent="Theme.Material3.DayNight.Dialog"/>

    <!-- No pill behind the active nav item; the accent-tinted icon is the cue. -->
    <style name="Csync.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="CsyncMediaTab">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="CsyncMediaAction">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <style name="CsyncMediaControl">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
</resources>
