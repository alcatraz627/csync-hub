            android:icon="@drawable/ti_camera" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
        </service>
        <service android:name=".HubTiles$Clipboard" android:exported="true" android:label="@string/ti_clipboard"
            android:icon="@drawable/ti_clipboard" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
        </service>
        <service android:name=".HubTiles$Screen" android:exported="true" android:label="@string/ti_screen"
            android:icon="@drawable/ti_screen" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
        </service>
        <service android:name=".HubTiles$Photo" android:exported="true" android:label="@string/ti_photo"
            android:icon="@drawable/ti_photo" android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
